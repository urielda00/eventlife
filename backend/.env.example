# Production-shaped backend configuration. Copy to /srv/eventlife/.env and
# replace every angle-bracket placeholder. Never commit the populated file.
POSTGRES_DB=eventlife
POSTGRES_USER=eventlife_app
POSTGRES_PASSWORD=<secret>

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/eventlife
SPRING_DATASOURCE_USERNAME=eventlife_app
SPRING_DATASOURCE_PASSWORD=<same-secret>

APP_JWT_SECRET=<strong-secret-at-least-32-bytes>
APP_JWT_EXPIRATION=3600000
APP_CORS_ALLOWED_ORIGINS=<production-netlify-origin>

SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_PROFILES_ACTIVE=prod
